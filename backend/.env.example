# =============================================================================
# PARKOPS — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values before running the application.
# NEVER commit .env (with real values) to version control.
# =============================================================================

# --------------- SERVER / NODE -----------------------------------------------
NODE_ENV=development                         # development | staging | production
PORT=5000
# Both CLIENT_URL and FRONTEND_URL are read by server.js for CORS allowlist.
# In production (Render), set BOTH to the Vercel frontend URL.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --------------- DATABASE (REQUIRED) -----------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/smart_parking
# Production: use Atlas connection string with credentials in Secrets Manager

# --------------- AUTHENTICATION (REQUIRED) -----------------------------------
JWT_SECRET=replace_with_a_strong_min_32_char_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_strong_min_32_char_secret
JWT_ACCESS_EXPIRATION=15m                   # Short-lived access token
JWT_REFRESH_EXPIRATION=7d                   # Longer-lived refresh token

# --------------- REDIS -------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# Production: use Redis Cluster or ElastiCache URL
# Set this to 'true' in multi-instance production to enforce distributed locks
STRICT_REDIS_LOCKS=false

# --------------- CLOUDINARY (IMAGE STORAGE) ----------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------- EMAIL / SMTP ------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password        # Use an app password, not your account password
SMTP_FROM=noreply@parkops.io
FROM_NAME=ParkOps System

# --------------- AWS (PRODUCTION INFRASTRUCTURE) ----------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Prefer IAM roles over static credentials in production

# --------------- CLOUDWATCH --------------------------------------------------
CLOUDWATCH_LOG_GROUP=/parkops/api/production
CLOUDWATCH_LOG_STREAM=api-instance-1

# --------------- PAYMENT GATEWAY -------------------------------------------
# Currently using internal payment simulation (MockGateway).
# Replace with actual provider credentials when integrating a real payment gateway.
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# --------------- AI / LLM PROVIDER ------------------------------------------
# AI features are optional. Application continues without this configured.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Alternatively for Google AI:
GEMINI_API_KEY=your_gemini_api_key

# --------------- SOCKET.IO ---------------------------------------------------
# No additional env vars required for Socket.IO beyond REDIS_URL.
# Socket.IO uses Redis for multi-node pub/sub automatically.

# --------------- FRONTEND URL ------------------------------------------------
# Used for password reset links and CORS.
# Production Render value:
#   FRONTEND_URL=https://smart-parking-slot-reservation-system-kpaqns75g.vercel.app
#   CLIENT_URL=https://smart-parking-slot-reservation-system-kpaqns75g.vercel.app
FRONTEND_URL=http://localhost:5173

# --------------- MONITORING / SRE -------------------------------------------
# Application-level feature flags
STRICT_REDIS_LOCKS=false                   # Set true in production multi-node
