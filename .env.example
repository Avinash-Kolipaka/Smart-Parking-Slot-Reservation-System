# Backend Environment Variables (.env)
# Copy this file to backend/.env and fill in the values

# --- Application ---
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/parkops
# Note: For transactions (concurrency), MongoDB must be a replica set.

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# --- Email (e.g., SendGrid/Nodemailer) ---
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_pass

# --- Cloudinary (Image Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Payments (e.g., Stripe/Razorpay) ---
PAYMENT_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYMENT_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Frontend Environment Variables (frontend/.env) ---
# Copy this file to frontend/.env and fill in the values
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
