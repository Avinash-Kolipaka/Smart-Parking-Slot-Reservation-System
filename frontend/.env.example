# Backend API URL for production and preview builds.
# Set this in Vercel's environment variables dashboard (not in .env files committed to git).
# IMPORTANT: Use your actual Render service URL below.
#
# Primary variable (read first by frontend/src/services/api.js):
VITE_API_URL=https://smart-parking-slot-reservation-system.onrender.com/api
#
# Alias — also accepted if VITE_API_URL is not set:
VITE_API_BASE_URL=https://smart-parking-slot-reservation-system.onrender.com/api
