# Production API URL — Render backend.
# Vite bakes this in at build time (import.meta.env.VITE_API_URL).
# This file is read when `npm run build` is executed inside the frontend/ directory.
# The Vercel dashboard environment variable VITE_API_URL overrides this value,
# so make sure that is also set to the full Render URL (no trailing slash):
#   VITE_API_URL=https://smart-parking-slot-reservation-system.onrender.com/api
VITE_API_URL=https://smart-parking-slot-reservation-system.onrender.com/api
